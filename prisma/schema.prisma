generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Social {
  id                Int      @id @default(1)
  email             String
  phoneDisplay      String   @default("")
  phoneTel          String   @default("")
  instagramUsername String
  instagramUrl      String
  updatedAt         DateTime @updatedAt
}

model About {
  id        Int      @id @default(1)
  text1     String   @db.Text
  text2     String   @db.Text
  text3     String   @db.Text
  updatedAt DateTime @updatedAt
}

model WorkArea {
  id          Int    @id @default(autoincrement())
  title       String
  description String @db.Text
  icon        String @default("User")
  sortOrder   Int    @default(0)
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  image     String
  excerpt   String   @db.Text
  content   String   @db.Text
  writer    String?
  category  String   @default("Psikoloji")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id           Int      @id @default(1)
  workingHours String
  updatedAt    DateTime @updatedAt
}

model FaqCategory {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  title     String
  sortOrder Int    @default(0)
}

model FaqItem {
  id        Int    @id @default(autoincrement())
  question  String
  answer    String @db.Text
  category  String @default("terapi-sureci")
  sortOrder Int    @default(0)
}
